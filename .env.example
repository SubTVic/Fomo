# Database
DATABASE_URL="postgresql://fomo:fomo_dev@localhost:5432/fomo"
# Vercel/Neon: set to the direct (non-pooled) connection URL for prisma migrate deploy.
# On Vercel, copy the "Direct connection" string from the Neon/Vercel Postgres dashboard.
# Locally with Docker, set equal to DATABASE_URL.
DIRECT_URL="postgresql://fomo:fomo_dev@localhost:5432/fomo"

# Auth.js
NEXTAUTH_SECRET="generate-a-random-secret-here" # Run: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# App Mode
# false (default) → Prelaunch (Studie 2 + Prototyp + Gruppen-Registrierung CTAs)
# true            → Live quiz CTA
APP_LIVE="false"

# Pilot Data Export (required for /api/pilot/export)
PILOT_EXPORT_KEY="generate-a-random-key-here" # Run: openssl rand -base64 32

# Umami Analytics (optional — tracking is disabled if not set)
# 1. Create free account at https://umami.is
# 2. Add website → copy the Website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Optional: Shibboleth/SAML SSO (Phase 2)
# SSO_ISSUER=""
# SSO_CALLBACK_URL=""
# SSO_ENTRY_POINT=""
# SSO_CERT=""
