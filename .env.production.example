# ──────────────────────────────────────────────────────────────
# FOMO Production Environment Variables
# Copy to .env and fill in real values before deployment.
# ──────────────────────────────────────────────────────────────

# Database (Docker-internal connection)
DB_PASSWORD="CHANGE_ME_strong_random_password"
DATABASE_URL="postgresql://fomo:${DB_PASSWORD}@db:5432/fomo"
DIRECT_URL="postgresql://fomo:${DB_PASSWORD}@db:5432/fomo"

# Auth.js — Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_generate_random_secret"
NEXTAUTH_URL="https://fomo.tu-dresden.de"

# App Mode — "live" for production quiz
APP_MODE="live"

# Docker Compose port mappings (optional, defaults shown)
# APP_PORT=3000
# DB_PORT=5432

# ──────────────────────────────────────────────────────────────
# Shibboleth/SAML SSO (Phase 2 — configure after ZIH provides metadata)
# ──────────────────────────────────────────────────────────────
# SSO_ISSUER="https://fomo.tu-dresden.de"
# SSO_CALLBACK_URL="https://fomo.tu-dresden.de/api/auth/callback/shibboleth"
# SSO_ENTRY_POINT="https://idp.tu-dresden.de/idp/profile/SAML2/Redirect/SSO"
# SSO_CERT="base64-encoded-idp-certificate"
