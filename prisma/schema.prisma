generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon/Vercel Postgres: use direct (non-pooled) connection for migrations.
  // Set DIRECT_URL to the direct connection string in Vercel environment variables.
  // If unset, falls back to DATABASE_URL (works for local Docker).
  directUrl = env("DIRECT_URL")
}

// ─── Hochschulgruppen ────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?  // Hex color for UI, e.g. "#E63946"
  icon        String?  // Icon identifier, e.g. "globe", "music"
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups Group[]

  @@map("categories")
}

model Group {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String   @db.VarChar(200)
  longDescription  String?  @db.Text
  categoryId       String
  contactEmail     String?
  websiteUrl       String?
  instagramUrl     String?
  logoUrl          String?
  memberCount      Int?
  meetingSchedule  String?  // e.g. "Jeden Dienstag 19:00"
  isActive         Boolean  @default(true)
  isVerified       Boolean  @default(false) // Profile confirmed by the group itself
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ─── Matching-Attribute (aus CSV-Import) ─────────────────────
  career                  Boolean @default(false)
  tech                    Boolean @default(false)
  socialImpact            Boolean @default(false)
  party                   Boolean @default(false)
  religion                Boolean @default(false)
  sports                  Boolean @default(false)
  networking              Boolean @default(false)
  arts                    Boolean @default(false)
  music                   Boolean @default(false)
  timeLow                 Boolean @default(false)
  handsOn                 Boolean @default(false)
  outdoor                 Boolean @default(false)
  international           Boolean @default(false)
  beginnerFriendly        Boolean @default(false)
  competitive             Boolean @default(false)
  financialCost           Boolean @default(false)
  leadershipOpportunities Boolean @default(false)

  // Kategoriale Attribute
  language       String? // "german", "both", "english"
  eventFrequency String? // "low", "medium", "high"
  groupSize      String? // "small", "medium", "large"

  // Event-Daten (nächstes bekanntes Event)
  nextEventTitle    String?
  nextEventDate     String?
  nextEventTime     String?
  nextEventLocation String?
  nextEventUrl      String?
  nextEventIsOpen   Boolean @default(false)

  // ─── Registrierung ───────────────────────────────────────────
  registeredVia     String?   // "import" | "survey" | "admin"
  registeredAt      DateTime?
  contactPerson     String?   // Ansprechperson (intern, nicht öffentlich)
  contactPersonRole String?   // z.B. "Vorsitzende:r"
  onboardingInfo    String?   @db.Text
  motto             String?   // Slogan der Gruppe
  foundedYear       Int?

  // ─── Scraper & Registration ──────────────────────────────────
  // JSON: {career: {value:1, confidence:0.8, reason:"..."}, ...}
  scraperAttributes   Json?
  // JSON: {career: 1, tech: 0, ...} — final confirmed binary values
  confirmedAttributes Json?
  registrationStatus  RegistrationStatus?
  submittedAt         DateTime?
  verifiedAt          DateTime?

  category Category     @relation(fields: [categoryId], references: [id])
  invites  GroupInvite[]

  @@index([categoryId])
  @@index([isActive])
  @@index([registeredVia])
  @@index([registrationStatus])
  @@map("groups")
}

// ─── Gruppen-Einladung (Token-basierte Registrierung) ────────────

model GroupInvite {
  id        String    @id @default(cuid())
  token     String    @unique // Random 32-char token
  groupId   String
  email     String
  createdAt DateTime  @default(now())
  expiresAt DateTime  // e.g. 30 days after creation
  usedAt    DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_invites")
}

// ─── Admin & Auth ────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN // StuRa staff, full access
  EDITOR      // Can edit groups and questions
}

enum RegistrationStatus {
  INVITED
  SUBMITTED
  VERIFIED
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?   // For credentials login (Phase 1)
  ssoId        String?   @unique // For Shibboleth/SAML (Phase 2)
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admins")
}

// ─── Site Configuration (CMS) ────────────────────────────────────

model SiteConfig {
  key       String   @id          // e.g. "hero_title", "image_1_src"
  value     String   @db.Text     // Text content or image URL
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

// ─── Analytics (anonymous) ───────────────────────────────────────

model QuizSession {
  id            String    @id @default(cuid())
  semester      String?   // e.g. "WS26/27" — for semester comparisons
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  questionCount Int       @default(0) // How many questions were answered
  resultCount   Int       @default(0) // How many results were shown
  answers       Json?     // Anonymous: {thesisId: value} snapshot
  topMatches    Json?     // Anonymous: [{groupId, score}] top results
  deviceType    String?   // "mobile" | "desktop"
  abortedAtQ    Int?      // Question number at which user abandoned (null = completed)
  // No personal data, no IP, no user agent

  @@index([semester])
  @@index([completedAt])
  @@index([startedAt])
  @@map("quiz_sessions")
}

// ─── Quiz-Thesen (Live-Quiz) ──────────────────────────────────────

model QuizThesis {
  id         String   @id @default(cuid())
  text       String   @db.Text       // Thesis statement shown to users
  shortTitle String   @db.VarChar(50) // Short label, e.g. "Zeitaufwand"
  hint       String?  @db.VarChar(200) // Visible explanation below the thesis, e.g. "z.B. Religion, Philosophie, Ethik"
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attributes QuizThesisAttribute[]
  versions   QuizThesisVersion[]

  @@map("quiz_theses")
}

model QuizThesisAttribute {
  id        String  @id @default(cuid())
  thesisId  String
  attribute String  // e.g. "career", "timeLow", "networking"
  isInverse Boolean @default(false)

  thesis QuizThesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@unique([thesisId, attribute])
  @@index([thesisId])
  @@map("quiz_thesis_attributes")
}

// ─── Semester-Archiv (Langzeit-Datenerfassung) ───────────────────

model SemesterArchive {
  id             String   @id @default(cuid())
  tag            String   @unique // e.g. "WS26/27", "SS27"
  startDate      DateTime
  endDate        DateTime
  thesisSnapshot Json     // Active theses at archival time
  statistics     Json     // Aggregated quiz stats
  groupCount     Int
  sessionCount   Int
  completionRate Float
  createdAt      DateTime @default(now())

  @@map("semester_archives")
}

// ─── Thesen-Versionierung (für Semester-Vergleiche) ──────────────

model QuizThesisVersion {
  id                String    @id @default(cuid())
  thesisId          String
  text              String    @db.Text
  hint              String?   @db.VarChar(200)
  attributeMappings Json      // [{attribute, isInverse}]
  semesterTag       String
  validFrom         DateTime
  validUntil        DateTime?
  createdAt         DateTime  @default(now())

  thesis QuizThesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@index([thesisId])
  @@map("quiz_thesis_versions")
}

