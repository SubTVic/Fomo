# Umami analytics (optional). The script only loads when the website id is set.
# These are NEXT_PUBLIC_* so they are inlined at build time — rebuild after a change.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Defaults to https://cloud.umami.is/script.js when unset.
NEXT_PUBLIC_UMAMI_SRC=
