# SPDX-License-Identifier: AGPL-3.0-only
# Copy to .env and adjust. NEXT_PUBLIC_* values are inlined at BUILD time —
# rebuild (./scripts/update-data.sh) after changing them.

# --- Web serving ---
# Host port nginx listens on (Docker Compose).
WEB_PORT=8080
# Optional subpath if FOMO is not hosted at "/" (e.g. /fomo). Must start with /.
NEXT_PUBLIC_BASE_PATH=

# --- Analytics (optional) ---
# Umami website id; the tracking script only loads when this is set.
UMAMI_WEBSITE_ID=
# Script URL; defaults to https://cloud.umami.is/script.js when unset.
# For a self-hosted Umami use e.g. https://umami.stura.de/script.js
UMAMI_SRC=

# --- Self-hosted Umami (only for `docker compose --profile analytics`) ---
UMAMI_PORT=3000
# Generate once: openssl rand -hex 32
UMAMI_APP_SECRET=please-change-me
UMAMI_DB_PASSWORD=please-change-me
