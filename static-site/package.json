{
  "name": "fomo-static-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Static public FOMO site — client-side quiz, build-time JSON data, no server",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-data.mjs && node scripts/report.mjs --out public/report/index.html",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "node scripts/validate-data.mjs",
    "report": "node scripts/report.mjs",
    "scrape": "node scripts/scrape-groups.mjs",
    "scrape:llm": "node scripts/scrape-llm.mjs",
    "scrape:eval": "node scripts/scrape-eval.mjs",
    "derive": "node scripts/derive-selfrating.mjs",
    "derive:train": "node scripts/train-derive-model.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/lexend": "^5.2.11",
    "next": "16.3.8",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
