{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/K",
      "destination": "/quiz/?utm_source=kondom&utm_medium=print&utm_campaign=erstiwoche_ws26",
      "permanent": false
    },
    {
      "source": "/K/",
      "destination": "/quiz/?utm_source=kondom&utm_medium=print&utm_campaign=erstiwoche_ws26",
      "permanent": false
    },
    {
      "source": "/k",
      "destination": "/quiz/?utm_source=kondom&utm_medium=print&utm_campaign=erstiwoche_ws26",
      "permanent": false
    },
    {
      "source": "/k/",
      "destination": "/quiz/?utm_source=kondom&utm_medium=print&utm_campaign=erstiwoche_ws26",
      "permanent": false
    }
  ]
}
